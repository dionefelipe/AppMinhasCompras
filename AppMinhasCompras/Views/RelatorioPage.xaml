<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMinhasCompras.Views.RelatorioPage"
             Title="Relatório por Categoria">

    <StackLayout Padding="15">
        <Label Text="Gastos Totais por Categoria" 
               FontSize="20" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               Margin="0,0,0,15" />

        <CollectionView x:Name="cv_relatorio">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10" CornerRadius="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   Text="{Binding Categoria}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" />
                            <Label Grid.Column="1" 
                                   Text="{Binding TotalGasto, StringFormat='{0:C}'}" 
                                   FontSize="16" 
                                   TextColor="Green" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>